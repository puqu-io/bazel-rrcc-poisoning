+
+  /**
+   * Thrown by {@link #injectRemoteRepo} when the cached repo contents were found but the prefetch of
+   * the files needed for loading failed. The caller should treat this like a cache miss, but report
+   * it.
+   */
+  public static final class RemoteRepoInjectionException extends IOException {
+    RemoteRepoInjectionException(int fileCount, BulkTransferException cause) {
+      super(buildMessage(fileCount, cause), cause);
+    }
+
+    private static String buildMessage(int fileCount, BulkTransferException cause) {
+      var sb = new StringBuilder();
+      sb.append("found a cache entry but failed to download ")
+          .append(cause.getSuppressed().length)
+          .append(" of ")
+          .append(fileCount)
+          .append(" prefetched file(s); treating as a cache miss and fetching locally");
+      // The prefetcher reports every download error as "not found". When the download failed for
+      // another reason, the real error is the cause; surface the first one.
+      var rootCauses = new LinkedHashSet<String>();
+      for (Throwable suppressed : cause.getSuppressed()) {
+        var root = suppressed.getCause();
+        if (root != null) {
+          rootCauses.add(root.toString());
+        }
+      }
+      if (rootCauses.isEmpty()) {
+        sb.append(" (the files are missing from the remote cache)");
+      } else {
+        sb.append(" (download error: ").append(Iterables.getFirst(rootCauses, "")).append(")");
+      }
+      return sb.toString();
+    }
+  }
